# Copie para "fase5.env" (mesma pasta) e preencha. O fase5.env NUNCA vai para o Git.
#
# Senha do usuário master do RDS (mín. 8 caracteres, sem @ / " e espaço).
DB_PASSWORD=
#
# Datadog -> Organization Settings > API Keys (32 caracteres)
DATADOG_API_KEY=
# Datadog -> Organization Settings > Application Keys (só para o datadog-aiops.ps1)
DATADOG_APP_KEY=
# Site do Datadog (vazio = datadoghq.com). O testar-integracoes.ps1 descobre o seu.
DATADOG_SITE=
#
# PagerDuty -> Services > "SolidaryTech" > Integrations > Events API V2 > Integration Key
PAGERDUTY_ROUTING_KEY=
#
# Discord -> Canal > Editar canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=
#
# Senha do admin do Grafana (vazio = gera uma aleatória)
GRAFANA_ADMIN_PASSWORD=
